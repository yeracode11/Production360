# === Внутреннее (только на сервере: API → Postgres в docker) ===
DATABASE_URL=postgresql+asyncpg://production360:ВАШ_ПАРОЛЬ@localhost:5433/production360

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Bearer мобилки (только чтение после настройки SYNC_BEARER_TOKEN).
# Это токен, зашитый в приложение. Сгенерировать: openssl rand -hex 32
API_BEARER_TOKEN=замените-на-длинный-секретный-токен

# Bearer 1С для /sync/* (НЕ класть в мобилку). openssl rand -hex 32
# Пока пусто — /sync/* принимает API_BEARER_TOKEN (старое поведение).
SYNC_BEARER_TOKEN=
# true — переходный режим: /sync/* принимает оба токена, пока 1С переключают.
SYNC_ACCEPT_LEGACY_TOKEN=false
# Необязательно: новый токен мобилки только на чтение (для будущей ротации).
MOBILE_BEARER_TOKEN=

# Пересчёт кэша групп через N сек после последней пачки /sync/products (0 — сразу, как раньше)
CATALOG_REBUILD_DEBOUNCE_SECONDS=5

# Минимальная версия мобилки для force update (GET /app/version)
MIN_APP_VERSION=1.0.1
MIN_APP_VERSION_IOS=1.0.2
MIN_APP_VERSION_ANDROID=1.0.1

# Публичный URL: https://p360.darasoft.kz
# Header: Authorization: Bearer <API_BEARER_TOKEN>
