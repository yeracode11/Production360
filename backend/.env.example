# === Внутреннее (только на сервере: API → Postgres в docker) ===
DATABASE_URL=postgresql+asyncpg://production360:ВАШ_ПАРОЛЬ@localhost:5433/production360

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Bearer для 1С и мобилки (один токен). Сгенерировать: openssl rand -hex 32
API_BEARER_TOKEN=замените-на-длинный-секретный-токен

# Публичный URL: https://p360.darasoft.kz
# Header: Authorization: Bearer <API_BEARER_TOKEN>
