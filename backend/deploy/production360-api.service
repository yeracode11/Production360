[Unit]
Description=Production360 FastAPI
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Production360/backend
EnvironmentFile=/root/Production360/backend/.env
ExecStart=/root/Production360/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
